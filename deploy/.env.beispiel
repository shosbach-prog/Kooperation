# Kopieren nach .env und anpassen:  cp .env.beispiel .env
# Ihre Adresse, z. B. von DuckDNS:
DOMAIN=mein-dienstplan.duckdns.org
# Optional: Unterordner, z. B. /LWL → https://DOMAIN/LWL (leer = direkt unter der Domain)
BASE_PATH=
# Startpasswort für den Benutzer "manager" (nach der ersten Anmeldung ändern!)
MANAGER_PASSWORD=bitte-langes-passwort-waehlen
# 0 = ohne Demo-Personal und Demo-Passwörter starten (im Echtbetrieb Pflicht)
SEED_DEMO=0
# Passwort für verschlüsselte Sicherungen (mind. 12 Zeichen; install.sh erzeugt eines). Zusätzlich sicher aufbewahren!
BACKUP_PASSWORT=
# Optional: Sicherungen per rsync/SSH auf einen zweiten Rechner kopieren, z. B. benutzer@nas.example.de:/sicherungen
BACKUP_KOPIE_ZIEL=
# Optional: Aufbewahrung in Tagen (Standard 14) und Warnschwelle für /api/health?backup=1 in Stunden (Standard 26)
# BACKUP_TAGE=14
# BACKUP_MAX_STD=26
# Optional: E-Mail-Benachrichtigungen (sonst nur in der App und per Push)
# SMTP_HOST=smtp.example.de
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Dienstplan <dienstplan@example.de>
# Adresse der Anwendung für Links in E-Mails (Standard: https://DOMAIN + BASE_PATH)
# APP_URL=
# Kontakt für Web-Push (mailto: oder https:)
# VAPID_SUBJECT=mailto:it@example.de
# Demo-Bereich unter /demo/ mit getrennten Beispieldaten; Startseite bietet "Als Leitung"/"Als Pflegekraft" ohne Anmeldung (0 = aus)
DEMO_BEREICH=1
# Nur für reine Vorführ-Server: Rollenauswahl ohne Passwort auch für die Hauptdaten (NIE mit echten Daten!)
DEMO_MODUS=0
# Optional: Anmeldung über das Klinik-Konto (Single Sign-on, OpenID Connect – z. B. Microsoft Entra ID)
# OIDC_ISSUER=https://login.microsoftonline.com/<Mandanten-ID>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Klinik-Konto
# OIDC_ZUORDNUNG=email          (email = über die E-Mail in der Personalakte, benutzername = über den Benutzernamen)
# OIDC_2FA=0                    (1 = zusätzlich eigenen Zwei-Faktor-Code verlangen)
